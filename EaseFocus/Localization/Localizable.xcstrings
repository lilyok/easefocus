    "When on, EaseFocus may add optional Google search terms to tasks where they help. These are search suggestions, not links. Nothing is sent to Google during generation or when you save the plan." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, EaseFocus may add optional Google search terms to tasks where they help. These are search suggestions, not links. Nothing is sent to Google during generation or when you save the plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, EaseFocus puede añadir términos de búsqueda de Google opcionales a las tareas donde ayuden. Son sugerencias de búsqueda, no enlaces. No se envía nada a Google durante la generación ni al guardar el plan."
          }
        }
      }
    },
